import React from 'react';
import { useMarketplace } from '../context/MarketplaceContext';
import { 
  Star, 
  ShieldCheck, 
  Award, 
  CheckCircle, 
  Calendar, 
  MapPin, 
  RotateCcw, 
  ArrowRightLeft,
  Sparkles,
  Heart,
