    setRole, 
    activeUser, 
    clientUser, 
    cleaners, 
    activeCleanerId, 
    setActiveCleanerId,
    jobs,
    resetData
  } = useMarketplace();

  // Find reviews targeting this user
  const reviewsReceived = jobs
    .flatMap(j => [j.clientReview, j.cleanerReview])
