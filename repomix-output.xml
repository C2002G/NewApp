import React, { useState } from 'react';
import { useMarketplace } from '../context/MarketplaceContext';
import { CleaningJob } from '../types';
import { 
  Radar, 
  MapPin, 
  Calendar, 
  Clock, 
  DollarSign, 
  CheckCircle, 
  Send, 
  Star, 
  ShieldCheck, 
  MessageSquare, 
